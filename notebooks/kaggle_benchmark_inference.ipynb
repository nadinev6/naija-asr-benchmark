## 2. Config
</markdown_cell>

<code_cell>
from __future__ import annotations

import json
import os
import time
from pathlib import Path

import numpy as np
import pandas as pd
import soundfile as sf
import torch
from transformers import WhisperForConditionalGeneration, WhisperProcessor

# --- EDIT THIS to match your Kaggle private dataset name ---
DATASET_NAME = "naija-asr-benchmark-audio"
# -----------------------------------------------------------

MODELS = {
    "whisper-large-v3": "openai/whisper-large-v3",
    "whisper-small": "openai/whisper-small",
    "naija-finetuned": "nadinev/naija-voice-model",
}

AUDIO_DIR = Path(f"/kaggle/input/{DATASET_NAME}/audio")
CSV_PATH = Path(f"/kaggle/input/{DATASET_NAME}/test_samples.csv")
OUT_DIR = Path("/kaggle/working")

device = "cuda" if torch.cuda.is_available() else "cpu"
hf_token = os.environ.get("HUGGINGFACE_HUB_TOKEN", None)

print(f"Device: {device}")
if device == "cuda":
    print(f"  GPU: {torch.cuda.get_device_name(0)}")
    print(f"  Memory: {torch.cuda.get_device_properties(0).total_mem / 1e9:.1f} GB")
if hf_token:
    print(f"HF Hub auth: token provided ({hf_token[:8]}...)")
else:
    print("[WARN] No HUGGINGFACE_HUB_TOKEN found — naija-finetuned will fail if private")
print(f"Audio dir: {AUDIO_DIR}")
print(f"CSV path: {CSV_PATH}")
print(f"Output dir: {OUT_DIR}")
</code_cell>

<markdown_cell>
## 3. Helper Functions
</markdown_cell>

<code_cell>
def load_audio_mono(path: str | Path, target_sr: int = 16000) -> np.ndarray:
    array, sr = sf.read(str(path), dtype="float32", always_2d=False)
    if array.ndim > 1:
        array = array.mean(axis=1)
    if sr != target_sr:
        new_len = int(len(array) * target_sr / sr)
        array = np.interp(
            np.linspace(0, len(array) - 1, new_len),
            np.arange(len(array)),
            array,
        ).astype(np.float32)
    return array


def load_whisper_model(
    model_id: str,
    device: str,
    hf_token: str | None = None,
) -> tuple[WhisperForConditionalGeneration, WhisperProcessor, bool]:
    use_bf16 = device == "cuda" and torch.cuda.is_bf16_supported()
    if use_bf16:
        dtype = torch.bfloat16
    elif device == "cuda":
        dtype = torch.float16
    else:
        dtype = torch.float32

    load_kwargs = {}
    if hf_token:
        load_kwargs["token"] = hf_token

    import transformers.tokenization_utils_base as _tub
    _orig_sst = _tub.PreTrainedTokenizerBase._set_model_specific_special_tokens
    def _safe_sst(self, special_tokens):
        if isinstance(special_tokens, list):
            special_tokens = {}
        return _orig_sst(self, special_tokens)
    _tub.PreTrainedTokenizerBase._set_model_specific_special_tokens = _safe_sst
    try:
        processor = WhisperProcessor.from_pretrained(str(model_id), **load_kwargs)
    finally:
        _tub.PreTrainedTokenizerBase._set_model_specific_special_tokens = _orig_sst

    model = WhisperForConditionalGeneration.from_pretrained(
        str(model_id), torch_dtype=dtype, **load_kwargs
    )
    model.to(device)
    model.eval()
    return model, processor, use_bf16


@torch.inference_mode()
def transcribe_with_word_probs(
    model, processor, audio: np.ndarray, *,
    device: str, use_bf16: bool, language: str = "en",
    task: str = "transcribe", max_new_tokens: int = 225,
    num_beams: int = 10, no_repeat_ngram_size: int = 3,
) -> dict:
    inputs = processor(audio, sampling_rate=16000, return_tensors="pt")
    inputs = {k: v.to(device) for k, v in inputs.items()}
    if use_bf16:
        inputs = {k: v.to(torch.bfloat16) if v.dtype == torch.float32 else v for k, v in inputs.items()}
    elif device == "cuda":
        inputs = {k: v.to(torch.float16) if v.dtype == torch.float32 else v for k, v in inputs.items()}

    outputs = model.generate(
        **inputs, max_new_tokens=max_new_tokens,
        language=language, task=task, num_beams=num_beams,
        no_repeat_ngram_size=no_repeat_ngram_size,
        length_penalty=1.0, condition_on_prev_tokens=False,
        return_dict_in_generate=True, output_scores=True,
    )

    text = processor.batch_decode(outputs.sequences, skip_special_tokens=True)[0]

    all_logprobs = []
    all_token_ids = []
    if outputs.scores:
        for i, score in enumerate(outputs.scores):
            probs = torch.nn.functional.log_softmax(score, dim=-1)
            token_id = outputs.sequences[0, i + 1].item() if i + 1 < outputs.sequences.shape[1] else None
            if token_id is not None:
                all_logprobs.append(float(probs[0, token_id].item()))
                all_token_ids.append(token_id)

    avg_logprob = float(np.mean(all_logprobs)) if all_logprobs else 0.0
    min_logprob = float(np.min(all_logprobs)) if all_logprobs else 0.0

    return {
        "text": text, "avg_logprob": avg_logprob, "min_logprob": min_logprob,
        "token_logprobs": json.dumps(all_logprobs),
        "token_ids": json.dumps(all_token_ids), "n_tokens": len(all_logprobs),
    }
</code_cell>

<markdown_cell>
## 4. Discover Audio Files
</markdown_cell>

<code_cell>
# Map audio filenames to sample_ids
audio_files = sorted(AUDIO_DIR.glob("*.flac"))
print(f"Found {len(audio_files)} audio files in {AUDIO_DIR}")

if len(audio_files) == 0:
    raise RuntimeError(f"No .flac files found in {AUDIO_DIR}. Check DATASET_NAME.")

# Derive sample_ids from filenames
sample_id_to_file = {}
for f in audio_files:
    sid = f.stem  # filename without .flac extension
    sample_id_to_file[sid] = f

print(f"Sample IDs from filenames: {len(sample_id_to_file)}")

# Load metadata CSV
if not CSV_PATH.is_file():
    raise RuntimeError(f"test_samples.csv not found at {CSV_PATH}. Check DATASET_NAME.")

meta_df = pd.read_csv(CSV_PATH)
print(f"Loaded metadata: {len(meta_df)} rows, columns={list(meta_df.columns)}")

# Validate all sample_ids have audio files
missing_audio = [sid for sid in meta_df["sample_id"] if sid not in sample_id_to_file]
if missing_audio:
    print(f"[WARN] {len(missing_audio)} sample_ids have no matching audio file (e.g., {missing_audio[0]})")

# Build ordered list
valid_samples = []
for _, row in meta_df.iterrows():
    sid = str(row["sample_id"])
    if sid in sample_id_to_file:
        valid_samples.append({
            "sample_id": sid,
            "text": str(row.get("text", "")),
            "accent_background": str(row.get("accent_background", "unknown")),
            "audio_path": str(sample_id_to_file[sid]),
        })

print(f"Valid samples with audio: {len(valid_samples)} / {len(meta_df)}")
sample_df = pd.DataFrame(valid_samples)
</code_cell>

<markdown_cell>
## 5. Run Inference — One Model at a Time
</markdown_cell>

<code_cell>
for model_id, model_name in MODELS.items():
    out_path = OUT_DIR / f"{model_id}_hypotheses.csv"

    # Skip if already completed
    if out_path.is_file():
        print(f"\n[SKIP] {out_path.name} already exists")
        continue

    print(f"\n{'='*60}")
    print(f"Model: {model_id} ({model_name})")
    print(f"{'='*60}")

    # Load model
    t_load = time.time()
    model, processor, use_bf16 = load_whisper_model(model_name, device, hf_token)
    load_time = time.time() - t_load
    print(f"  Loaded in {load_time:.1f}s — "
          f"dtype: {'bf16' if use_bf16 else 'fp16' if device == 'cuda' else 'fp32'}")

    # Transcribe
    rows = []
    t_start = time.time()
    for idx, row in sample_df.iterrows():
        audio_path = row["audio_path"]
        sid = row["sample_id"]
        accent = row["accent_background"]

        try:
            audio = load_audio_mono(audio_path)
            t_sample = time.time()
            result = transcribe_with_word_probs(
                model, processor, audio,
                device=device, use_bf16=use_bf16,
            )
            elapsed = time.time() - t_sample
            rows.append({
                "sample_id": sid, "model_id": model_id,
                "hypothesis_text": result["text"],
                "avg_logprob": result["avg_logprob"],
                "min_logprob": result["min_logprob"],
                "token_logprobs": result["token_logprobs"],
                "token_ids": result["token_ids"],
                "n_tokens": result["n_tokens"],
                "inference_time_s": round(elapsed, 3),
                "accent_background": accent,
            })
        except Exception as e:
            print(f"  [ERROR] {sid}: {e}")
            rows.append({
                "sample_id": sid, "model_id": model_id,
                "hypothesis_text": f"[ERROR: {e}]",
                "avg_logprob": 0.0, "min_logprob": 0.0,
                "token_logprobs": "[]", "token_ids": "[]",
                "n_tokens": 0, "inference_time_s": 0.0,
                "accent_background": accent,
            })

        if (idx + 1) % 50 == 0:
            elapsed_total = time.time() - t_start
            rate = (idx + 1) / elapsed_total if elapsed_total > 0 else 0
            print(f"  Progress: {idx + 1}/{len(sample_df)} ({rate:.1f} samples/s) — "
                  f"elapsed {elapsed_total:.0f}s")

    total_time = time.time() - t_start
    print(f"  Completed {len(rows)}/{len(sample_df)} samples in {total_time:.1f}s "
          f"({len(rows)/total_time:.1f} samples/s)")

    # Save
    result_df = pd.DataFrame(rows)
    result_df.to_csv(out_path, index=False)
    print(f"  Saved to {out_path}")

    del model, processor
    torch.cuda.empty_cache()
    print(f"  Unloaded model, GPU memory freed")

print("\nAll models completed.\n")
</code_cell>

