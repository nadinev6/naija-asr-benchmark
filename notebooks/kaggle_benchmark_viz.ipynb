<markdown_cell>
## 2. Load Data
</markdown_cell>

<code_cell>
import json
from pathlib import Path

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid", font_scale=1.1)
plt.rcParams["figure.figsize"] = (12, 6)

# --- paths (Kaggle dataset input) ---
DATA_DIR = Path("/kaggle/input/dialect-aware-asr-error-taxonomy")  # Kaggle mount
if not DATA_DIR.is_dir():
    DATA_DIR = Path("../../data/kaggle_benchmark")  # local fallback

# Load results
results_path = DATA_DIR / "analysis" / "results.json"
with open(results_path) as f:
    results = json.load(f)

metrics_df = pd.DataFrame(results["metrics"]).T.reset_index(drop=True)
summary = results["summary"]
models_summary = summary["models"]

# Load test samples metadata
samples_path = DATA_DIR / "dataset" / "test_samples_kaggle.csv"
samples_df = pd.read_csv(samples_path)

print(f"Models: {list(models_summary.keys())}")
print(f"Total samples: {len(samples_df)}")
print(f"Dialects: {samples_df['accent_background'].value_counts().to_dict()}")
</code_cell>

<markdown_cell>
## 3. Per-Dialect WER — 3 Models Side-by-Side
</markdown_cell>

<code_cell>
fig, axes = plt.subplots(1, 2, figsize=(16, 6))

for idx, (model_id, model_data) in enumerate(models_summary.items()):
    ax = axes[idx]
    dialects = list(model_data["dialects"].keys())
    wers = [model_data["dialects"][d] for d in dialects]
    penalties = [model_data["dialect_penalties"][d] for d in dialects]

    x = np.arange(len(dialects))
    width = 0.35

    bars1 = ax.bar(x - width/2, wers, width, label="Raw WER", color="#4C72B0")
    bars2 = ax.bar(x + width/2, penalties, width, label="Dialect Penalty", color="#DD8452")

    ax.set_xlabel("Dialect")
    ax.set_ylabel("WER")
    ax.set_title(f"{model_id}\nRaw WER: {model_data['raw_wer']:.2%}")
    ax.set_xticks(x)
    ax.set_xticklabels([d.title() for d in dialects], rotation=25)
    ax.legend()
    ax.bar_label(bars1, fmt="%.2f", padding=2, fontsize=8)
    ax.bar_label(bars2, fmt="%.2f", padding=2, fontsize=8)

plt.suptitle("Dialect-Aware WER by Model and Dialect", fontsize=14, y=1.02)
plt.tight_layout()
plt.show()

# Combined view if 3 models
if len(models_summary) == 3:
    fig, ax = plt.subplots(figsize=(14, 6))

    model_ids = list(models_summary.keys())
    all_dialects = sorted(set(
        d for m in models_summary.values() for d in m["dialects"].keys()
    ))

    x = np.arange(len(all_dialects))
    n_models = len(model_ids)
    width = 0.8 / n_models
    colors = ["#4C72B0", "#DD8452", "#55A868"]

    for i, mid in enumerate(model_ids):
        wers = [models_summary[mid]["dialects"].get(d, 0) for d in all_dialects]
        offset = (i - n_models/2 + 0.5) * width
        ax.bar(x + offset, wers, width, label=mid, color=colors[i % len(colors)])

    ax.set_xlabel("Dialect")
    ax.set_ylabel("Raw WER")
    ax.set_title("Raw WER Comparison Across Models")
    ax.set_xticks(x)
    ax.set_xticklabels([d.title() for d in all_dialects], rotation=25)
    ax.legend()
    plt.tight_layout()
    plt.show()
</code_cell>

<markdown_cell>
## 4. Dialect Penalty Analysis
</markdown_cell>

<code_cell>
penalty_data = []
for model_id, model_data in models_summary.items():
    for dialect, penalty in model_data["dialect_penalties"].items():
        penalty_data.append({
            "model": model_id,
            "dialect": dialect.title(),
            "dialect_penalty": penalty,
            "raw_wer": model_data["dialects"][dialect],
            "faithful_wer": model_data["dialects"][dialect] - penalty,
        })

penalty_df = pd.DataFrame(penalty_data)

fig, ax = plt.subplots(figsize=(14, 6))
sns.barplot(data=penalty_df, x="dialect", y="dialect_penalty", hue="model", ax=ax)
ax.set_title("Dialect Penalty by Dialect and Model")
ax.set_xlabel("Dialect")
ax.set_ylabel("Dialect Penalty (raw_wer - faithful_wer)")
plt.tight_layout()
plt.show()

# Identify which dialect has highest penalty
highest_penalty = penalty_df.loc[penalty_df["dialect_penalty"].idxmax()]
print(f"Highest dialect penalty: {highest_penalty['dialect']} "
      f"({highest_penalty['model']}, penalty={highest_penalty['dialect_penalty']:.4f})")
</code_cell>

<markdown_cell>
## 5. Hallucination Rate by Model and Dialect
</markdown_cell>

<code_cell>
hallucination_data = []
for model_id, model_data in models_summary.items():
    for dialect, wer in model_data["dialects"].items():
        key = f"{model_id}::{dialect}"
        m = results["metrics"].get(key, {})
        hallucination_data.append({
            "model": model_id,
            "dialect": dialect.title(),
            "hallucination_rate": m.get("hallucination_rate", 1.0),
            "total_errors": m.get("total_errors", 0),
            "hallucinations": m.get("hallucinations", 0),
            "faithful_variants": m.get("faithful_dialect_variants", 0),
        })

hall_df = pd.DataFrame(hallucination_data)

fig, axes = plt.subplots(1, 2, figsize=(16, 6))

# Hallucination rate
sns.barplot(data=hall_df, x="dialect", y="hallucination_rate", hue="model", ax=axes[0])
axes[0].set_title("Hallucination Rate (among errors)")
axes[0].set_ylabel("Rate")
axes[0].axhline(1.0, color="gray", linestyle="--", alpha=0.5)

# Error composition (stacked)
for ax_idx, model_id in enumerate(models_summary.keys()):
    ax = axes[1] if ax_idx == 0 else axes[1]
    model_hall = hall_df[hall_df["model"] == model_id]
    if len(model_hall) == 0:
        continue

    dialects = model_hall["dialect"].tolist()
    x = np.arange(len(dialects)) + (1 if ax_idx == 1 else 0) * 0.3

    ax.bar(x, model_hall["hallucinations"].values, 0.3,
           label=f"{model_id}: Hallucinations", alpha=0.7)
    ax.bar(x, model_hall["faithful_variants"].values, 0.3,
           bottom=model_hall["hallucinations"].values,
           label=f"{model_id}: Faithful Dialect", alpha=0.7)

    ax.set_xlabel("Dialect")
    ax.set_ylabel("Count")
    ax.set_title("Error Composition")
    ax.set_xticks(np.arange(len(dialects)))
    ax.set_xticklabels(dialects, rotation=25)

axes[1].legend()
plt.tight_layout()
plt.show()
</code_cell>

<markdown_cell>
## 6. Normalization Overcorrection Rate
</markdown_cell>

<code_cell>
norm_data = []
for model_id, model_data in models_summary.items():
    for dialect in model_data["dialects"]:
        key = f"{model_id}::{dialect}"
        m = results["metrics"].get(key, {})
        norm_data.append({
            "model": model_id,
            "dialect": dialect.title(),
            "norm_overcorrection_rate": m.get("normalization_overcorrection_rate", 0),
            "cause_dist": m.get("cause_distribution", {}),
        })

norm_df = pd.DataFrame(norm_data)

fig, ax = plt.subplots(figsize=(14, 6))
sns.barplot(data=norm_df, x="dialect", y="norm_overcorrection_rate", hue="model", ax=ax)
ax.set_title("Normalization Overcorrection Rate\n(How often model 'corrects' dialect to standard English)")
ax.set_xlabel("Dialect")
ax.set_ylabel("Overcorrection Rate")
plt.tight_layout()
plt.show()

print("Cause distribution per model-dialect:")
for _, row in norm_df.iterrows():
    if row["cause_dist"]:
        top_cause = max(row["cause_dist"], key=row["cause_dist"].get)
        print(f"  {row['model']} / {row['dialect']}: most common cause = {top_cause}")
</code_cell>

